---
// src/pages/[slug].astro
//
// Rute generik untuk WordPress "Pages" (bukan Post/artikel blog).
// Setiap kali kamu bikin Page baru di wp-admin (misal "kebijakan-privasi",
// "tentang-kami-lengkap"), halaman ini otomatis meng-generate route baru
// untuk itu SAAT BUILD - tidak perlu ubah kode apapun.
//
// PENTING: kalau ada Page WordPress yang slug-nya bentrok dengan rute yang
// sudah dipakai situs ini (misal "blog", "category"), build akan gagal
// dengan error "duplicate route" - itu sengaja, supaya tidak ada 2 halaman
// beda isi tapi rebutan URL yang sama. Kalau itu terjadi, ganti slug Page
// itu di wp-admin.

import Layout from '../layouts/Layout.astro';
import { getAllPages, getPageByUri } from '../lib/wordpress.js';
import { formatDateID } from '../lib/content.js';

export async function getStaticPaths() {
  const pages = await getAllPages();
  return pages.map((p) => ({
    params: { slug: p.slug },
    props: { uri: p.uri },
  }));
}

const { uri } = Astro.props;
const page = await getPageByUri(uri);

if (!page) {
  return Astro.redirect('/404');
}
---
<Layout
  title={page.title.replace(/<[^>]+>/g, '')}
  description={page.content?.replace(/<[^>]+>/g, '').slice(0, 155)}
>
  <article class="static-page">
    <div class="wrap">
      <h1 set:html={page.title} />
      {page.modified && (
        <p class="updated">Terakhir diperbarui: {formatDateID(page.modified)}</p>
      )}
      <div class="content" set:html={page.content} />
    </div>
  </article>
</Layout>

<style>
  .static-page {
    padding: 4rem 0 5rem;
    max-width: 760px;
    margin: 0 auto;
  }
  h1 {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    margin-bottom: 0.5rem;
  }
  .updated {
    color: var(--slate);
    font-size: 0.85rem;
    margin-bottom: 2rem;
  }
  .content {
    line-height: 1.8;
    color: var(--ink);
  }
  .content :global(h2) {
    font-family: var(--font-display);
    font-size: 1.35rem;
    margin: 2rem 0 0.9rem;
  }
  .content :global(h3) {
    font-family: var(--font-display);
    font-size: 1.1rem;
    margin: 1.5rem 0 0.75rem;
  }
  .content :global(p) { margin: 0 0 1.1rem; }
  .content :global(img) {
    max-width: 100%;
    border-radius: 12px;
    margin: 1.25rem 0;
  }
  .content :global(ul), .content :global(ol) {
    margin: 0 0 1.1rem;
    padding-left: 1.4rem;
  }
  .content :global(a) { color: var(--logo-purple); }
</style>
