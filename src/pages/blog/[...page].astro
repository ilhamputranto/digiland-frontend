---
// src/pages/blog/[...page].astro
// Menangani /blog (halaman 1), /blog/2, /blog/3, dst sekaligus - ini pola
// pagination bawaan Astro lewat helper `paginate()`.
//
// Post pertama (paling baru) ditampilkan sebagai "featured post" besar,
// HANYA di halaman 1. Sisanya masuk grid biasa yang dipaginasi.

import Layout from '../../layouts/Layout.astro';
import CTA from '../../components/CTA.astro';
import { getAllPosts, getCategoriesList, getTagsList } from '../../lib/wordpress.js';
import { estimateReadingTime, formatDateID } from '../../lib/content.js';

export async function getStaticPaths({ paginate }) {
  const { nodes: allPosts } = await getAllPosts({ first: 100 });
  const featured = allPosts[0];
  const rest = allPosts.slice(1);
  const categories = await getCategoriesList();
  const tags = await getTagsList();
  return paginate(rest, { pageSize: 6, props: { featured, categories, tags } });
}

const { page, featured, categories, tags } = Astro.props;
const isFirstPage = page.currentPage === 1;

// Bangun daftar nomor halaman dengan ellipsis ("1 2 3 ... 10") supaya rapi
// walau jumlah halaman banyak.
function buildPageNumbers(current, last) {
  const pages = new Set([1, last, current, current - 1, current + 1]);
  return Array.from(pages)
    .filter((n) => n >= 1 && n <= last)
    .sort((a, b) => a - b);
}
const pageNumbers = buildPageNumbers(page.currentPage, page.lastPage);
---
<Layout title="Blog" description="Insight, tips, dan tren terbaru seputar SEO & digital marketing dari Digiland.id.">
  <section class="blog-hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="dot-grid" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">Blog</p>
        <h1>Insight, tips, and trends<br />in <span class="accent">digital marketing</span></h1>
        <p class="subhead">
          Artikel terbaru seputar SEO, digital marketing, dan strategi online
          untuk membantu bisnis Anda tumbuh lebih cepat.
        </p>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <div class="float-card card-readers">
          <div class="icon-wrap" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--logo-purple)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87M15 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
          </div>
          <div>
            <p class="value">12K+</p>
            <p class="label">Monthly Readers</p>
          </div>
        </div>
        <div class="float-card card-chart">
          <svg class="mini-chart" viewBox="0 0 100 30" preserveAspectRatio="none">
            <polyline points="0,20 15,24 30,14 45,18 60,8 75,16 100,4" fill="none" stroke="#7f3f99" stroke-width="2.5"/>
          </svg>
        </div>
      </div>
    </div>

    <div class="wrap filter-bar">
      <div class="search-box">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
        <input type="text" id="blog-search" placeholder="Cari artikel..." />
      </div>
      <select id="blog-category">
        <option value="">Semua Kategori</option>
        {categories.map((c) => <option value={c.slug}>{c.name}</option>)}
      </select>
      <select id="blog-tag">
        <option value="">Semua Tag</option>
        {tags.map((t) => <option value={t.slug}>{t.name}</option>)}
      </select>
      <button type="button" id="blog-reset" class="reset-btn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 109-9 9.75 9.75 0 00-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
        Reset
      </button>
    </div>
  </section>

  {isFirstPage && featured && (
    <section class="featured reveal">
      <div class="wrap">
        <a href={`/blog/${featured.slug}`} class="featured-card">
          <div class="featured-image">
            <span class="featured-badge">Featured</span>
            {featured.featuredImage ? (
              <img src={featured.featuredImage.node.sourceUrl} alt={featured.featuredImage.node.altText || featured.title} />
            ) : (
              <div class="img-fallback" aria-hidden="true"></div>
            )}
          </div>
          <div class="featured-body">
            {featured.categories?.nodes?.[0] && (
              <span class="tag">{featured.categories.nodes[0].name}</span>
            )}
            <h2 set:html={featured.title} />
            <p class="excerpt" set:html={featured.excerpt} />
            <div class="featured-footer">
              <div class="author">
                <div class="avatar" aria-hidden="true">{featured.author?.node?.name?.[0] ?? 'D'}</div>
                <div>
                  <strong>{featured.author?.node?.name ?? 'Digiland.id'}</strong>
                  <span>{formatDateID(featured.date)} &middot; {estimateReadingTime(featured.excerpt)} min read</span>
                </div>
              </div>
              <span class="read-more">Baca Selengkapnya <span aria-hidden="true">→</span></span>
            </div>
          </div>
        </a>
      </div>
    </section>
  )}

  <section class="post-grid-section">
    <div class="wrap">
      <div class="grid-header">
        {isFirstPage && <p class="grid-label">Artikel Terbaru</p>}
        <div class="grid-controls">
          <select id="blog-sort" aria-label="Urutkan">
            <option value="newest">Terbaru</option>
            <option value="oldest">Terlama</option>
          </select>
          <div class="view-toggle" role="group" aria-label="Tampilan">
            <button type="button" data-view="grid" class="active" aria-label="Tampilan grid">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
            </button>
            <button type="button" data-view="list" aria-label="Tampilan list">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
            </button>
          </div>
        </div>
      </div>

      <div class="post-grid" id="post-grid">
        {page.data.map((post, i) => (
          <a
            href={`/blog/${post.slug}`}
            class={`post-card reveal reveal-${i % 3}`}
            data-title={post.title.toLowerCase()}
            data-category={post.categories?.nodes?.map((c) => c.slug).join(',') || ''}
            data-tag={post.tags?.nodes?.map((t) => t.slug).join(',') || ''}
            data-date={post.date}
          >
            <div class="post-image">
              {post.featuredImage ? (
                <img src={post.featuredImage.node.sourceUrl} alt={post.featuredImage.node.altText || post.title} loading="lazy" />
              ) : (
                <div class="img-fallback" aria-hidden="true"></div>
              )}
              {post.categories?.nodes?.[0] && (
                <span class="tag">{post.categories.nodes[0].name}</span>
              )}
            </div>
            <div class="post-body">
              <h3 set:html={post.title} />
              <div class="meta">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                <span>{formatDateID(post.date)}</span>
                <span class="dot">&middot;</span>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
                <span>{estimateReadingTime(post.excerpt)} min read</span>
              </div>
            </div>
          </a>
        ))}
      </div>
      <p class="empty-state" id="empty-state" hidden>Tidak ada artikel yang cocok.</p>

      {page.lastPage > 1 && (
        <nav class="pagination" aria-label="Pagination">
          <a
            href={page.url.prev ?? '#'}
            class:list={['page-btn', 'nav', { disabled: !page.url.prev }]}
            aria-disabled={!page.url.prev}
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
          </a>
          {pageNumbers.map((n, i) => (
            <>
              {i > 0 && n - pageNumbers[i - 1] > 1 && <span class="ellipsis">&hellip;</span>}
              <a
                href={n === 1 ? '/blog' : `/blog/${n}`}
                class:list={['page-btn', { active: page.currentPage === n }]}
              >
                {n}
              </a>
            </>
          ))}
          <a
            href={page.url.next ?? '#'}
            class:list={['page-btn', 'nav', { disabled: !page.url.next }]}
            aria-disabled={!page.url.next}
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
          </a>
        </nav>
      )}
    </div>
  </section>

  <CTA />
</Layout>

<style>
  .blog-hero {
    position: relative;
    padding: 3.5rem 0 2rem;
    background: linear-gradient(180deg, #faf6ff 0%, #fff 100%);
    overflow: hidden;
  }
  .hero-glow {
    position: absolute;
    inset: -10% -5% auto -5%;
    height: 60%;
    background: var(--spectrum);
    filter: blur(140px);
    opacity: 0.14;
    pointer-events: none;
  }
  .dot-grid {
    position: absolute;
    top: 8%;
    right: 4%;
    width: 100px;
    height: 80px;
    background-image: radial-gradient(var(--logo-purple) 1.4px, transparent 1.4px);
    background-size: 13px 13px;
    opacity: 0.25;
    pointer-events: none;
  }
  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 2rem;
    align-items: center;
  }
  h1 { font-size: clamp(1.9rem, 3.2vw, 2.5rem); line-height: 1.22; }
  .accent {
    background: var(--spectrum-btn);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .subhead { color: var(--slate); margin-top: 0.9rem; line-height: 1.65; max-width: 34rem; }

  .hero-visual { position: relative; height: 150px; }
  .float-card {
    position: absolute;
    background: #fff;
    border-radius: 14px;
    padding: 0.8rem 1rem;
    box-shadow: var(--shadow-card);
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .card-readers { top: 0; right: 10%; }
  .card-chart { bottom: 0; right: 0; width: 130px; padding: 0.7rem 0.9rem; }
  .icon-wrap {
    width: 34px; height: 34px; border-radius: 10px;
    background: rgba(127,63,153,0.1);
    display: grid; place-items: center; flex-shrink: 0;
  }
  .float-card .value { font-family: var(--font-display); font-size: 1.05rem; font-weight: 700; margin: 0; }
  .float-card .label { font-size: 0.72rem; color: var(--slate); margin: 0.1rem 0 0; }
  .mini-chart { width: 100%; height: 28px; }

  .filter-bar {
    display: flex;
    gap: 0.7rem;
    flex-wrap: wrap;
    margin-top: 2.25rem;
  }
  .search-box {
    flex: 1;
    min-width: 200px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 0.65rem 1rem;
    color: var(--slate);
  }
  .search-box input {
    border: none; outline: none; flex: 1;
    font-size: 0.9rem; font-family: var(--font-body); color: var(--ink);
  }
  #blog-category, #blog-tag {
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 0.65rem 1rem;
    font-size: 0.88rem;
    font-family: var(--font-body);
    color: var(--ink);
    background: #fff;
  }
  .reset-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid var(--line);
    background: #fff;
    border-radius: 10px;
    padding: 0.65rem 1rem;
    font-size: 0.85rem;
    color: var(--slate);
    cursor: pointer;
    font-family: var(--font-body);
  }
  .reset-btn:hover { color: var(--logo-purple); border-color: var(--logo-purple); }

  /* ---- featured ---- */
  .featured { padding: 3rem 0 1rem; }
  .featured-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: center;
    background: var(--paper-2);
    border-radius: var(--radius);
    padding: 1.25rem;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.25s ease;
  }
  .featured-card:hover { box-shadow: var(--shadow-card); }
  .featured-image { position: relative; border-radius: 14px; overflow: hidden; aspect-ratio: 4/3; }
  .featured-image img, .featured-image .img-fallback { width: 100%; height: 100%; object-fit: cover; display: block; }
  .img-fallback { background: linear-gradient(135deg, #eee, #f6f6f7); }
  .featured-badge {
    position: absolute;
    top: 0.9rem;
    left: 0.9rem;
    background: var(--spectrum-btn);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
  }
  .featured-body .tag {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--logo-purple);
    background: rgba(127,63,153,0.1);
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    margin-bottom: 0.75rem;
  }
  .featured-body h2 { font-size: clamp(1.3rem, 2.2vw, 1.7rem); line-height: 1.3; }
  .featured-body .excerpt { color: var(--slate); margin: 0.75rem 0 1.25rem; line-height: 1.6; font-size: 0.94rem; }
  .featured-body .excerpt :global(p) { margin: 0; }
  .featured-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .author { display: flex; align-items: center; gap: 0.6rem; }
  .avatar {
    width: 34px; height: 34px; border-radius: 50%;
    background: var(--spectrum-btn); color: #fff;
    display: grid; place-items: center;
    font-family: var(--font-display); font-weight: 700; font-size: 0.85rem;
    flex-shrink: 0;
  }
  .author strong { display: block; font-size: 0.82rem; }
  .author span { display: block; font-size: 0.74rem; color: var(--slate); }
  .read-more { color: var(--logo-purple); font-weight: 600; font-size: 0.88rem; white-space: nowrap; }

  /* ---- grid ---- */
  .post-grid-section { padding: 2.5rem 0 4rem; }
  .grid-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .grid-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--slate);
    margin: 0;
  }
  .grid-controls { display: flex; align-items: center; gap: 0.6rem; margin-left: auto; }
  #blog-sort {
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 0.45rem 0.7rem;
    font-size: 0.82rem;
    color: var(--slate);
    background: #fff;
  }
  .view-toggle {
    display: flex;
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
  }
  .view-toggle button {
    width: 32px; height: 32px;
    display: grid; place-items: center;
    background: #fff;
    border: none;
    color: var(--slate);
    cursor: pointer;
  }
  .view-toggle button.active { background: var(--logo-purple); color: #fff; }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .post-grid.list-view {
    grid-template-columns: 1fr;
  }
  .post-grid.list-view .post-card {
    display: grid;
    grid-template-columns: 220px 1fr;
  }
  .post-grid.list-view .post-image { aspect-ratio: auto; height: 100%; }

  .post-card {
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .post-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-card); }
  .post-image { position: relative; aspect-ratio: 16/10; }
  .post-image img, .post-image .img-fallback { width: 100%; height: 100%; object-fit: cover; display: block; }
  .post-image .tag {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    font-size: 0.7rem;
    font-weight: 600;
    color: #fff;
    background: rgba(20,20,20,0.65);
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    backdrop-filter: blur(4px);
  }
  .post-body { padding: 1.1rem 1.2rem 1.3rem; }
  .post-body h3 {
    font-size: 1rem;
    font-family: var(--font-body);
    font-weight: 600;
    line-height: 1.4;
    margin-bottom: 0.6rem;
  }
  .post-body .meta {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--slate);
    margin: 0;
    font-size: 0.76rem;
  }
  .empty-state { text-align: center; color: var(--slate); padding: 2rem 0; }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2.5rem;
  }
  .page-btn {
    width: 36px; height: 36px;
    border-radius: 8px;
    display: grid; place-items: center;
    text-decoration: none;
    color: var(--slate);
    border: 1px solid var(--line);
    font-size: 0.85rem;
  }
  .page-btn.active { background: var(--spectrum-btn); color: #fff; border-color: transparent; }
  .page-btn.disabled { opacity: 0.4; pointer-events: none; }
  .ellipsis { color: var(--slate); padding: 0 0.2rem; }

  .reveal-1 { transition-delay: 0.08s; }
  .reveal-2 { transition-delay: 0.16s; }

  @media (max-width: 860px) {
    .hero-inner { grid-template-columns: 1fr; }
    .hero-visual { display: none; }
    .featured-card { grid-template-columns: 1fr; }
    .post-grid { grid-template-columns: 1fr; }
    .post-grid.list-view .post-card { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Filter search + kategori + tag + sort - client-side, hanya memfilter
  // kartu di halaman yang sedang dibuka (situs ini statis/SSG).
  const searchInput = document.getElementById('blog-search');
  const categorySelect = document.getElementById('blog-category');
  const tagSelect = document.getElementById('blog-tag');
  const sortSelect = document.getElementById('blog-sort');
  const resetBtn = document.getElementById('blog-reset');
  const grid = document.getElementById('post-grid');
  const cards = Array.from(document.querySelectorAll('.post-card'));
  const emptyState = document.getElementById('empty-state');

  function applyFilter() {
    const q = (searchInput?.value || '').toLowerCase().trim();
    const cat = categorySelect?.value || '';
    const tag = tagSelect?.value || '';
    let visibleCount = 0;

    cards.forEach((card) => {
      const title = card.getAttribute('data-title') || '';
      const cardCats = (card.getAttribute('data-category') || '').split(',');
      const cardTags = (card.getAttribute('data-tag') || '').split(',');
      const matchesText = !q || title.includes(q);
      const matchesCategory = !cat || cardCats.includes(cat);
      const matchesTag = !tag || cardTags.includes(tag);
      const show = matchesText && matchesCategory && matchesTag;
      card.style.display = show ? '' : 'none';
      if (show) visibleCount++;
    });

    if (emptyState) emptyState.hidden = visibleCount !== 0;
  }

  function applySort() {
    if (!grid) return;
    const order = sortSelect?.value || 'newest';
    const sorted = [...cards].sort((a, b) => {
      const da = new Date(a.getAttribute('data-date') || 0).getTime();
      const db = new Date(b.getAttribute('data-date') || 0).getTime();
      return order === 'newest' ? db - da : da - db;
    });
    sorted.forEach((card) => grid.appendChild(card));
  }

  searchInput?.addEventListener('input', applyFilter);
  categorySelect?.addEventListener('change', applyFilter);
  tagSelect?.addEventListener('change', applyFilter);
  sortSelect?.addEventListener('change', applySort);
  resetBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    if (categorySelect) categorySelect.value = '';
    if (tagSelect) tagSelect.value = '';
    if (sortSelect) sortSelect.value = 'newest';
    applyFilter();
    applySort();
  });

  // Toggle tampilan grid / list
  document.querySelectorAll('.view-toggle button').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.view-toggle button').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      const view = btn.getAttribute('data-view');
      grid?.classList.toggle('list-view', view === 'list');
    });
  });
</script>
