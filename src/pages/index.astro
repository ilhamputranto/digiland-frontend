---
// src/pages/index.astro -> route "/"
// Karena digiland.id itu one-page site, homepage ini menyusun SEMUA section
// secara berurutan. Tidak ada fetch WordPress di sini karena semua konten
// masih statis (sesuai keputusan awal).

import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import StatsBar from '../components/StatsBar.astro';
import About from '../components/About.astro';
import Services from '../components/Services.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import Clients from '../components/Clients.astro';
import Testimonials from '../components/Testimonials.astro';
import CTA from '../components/CTA.astro';
---
<Layout
  title="Digital Marketing & SEO Services"
  description="Boost your brand's online presence with Digiland.id! Expert SEO & digital marketing services designed to increase visibility."
>
  <Hero />
  <StatsBar />
  <About />
  <Services />
  <WhyChooseUs />
  <Clients />
  <Testimonials />
  <CTA />
</Layout>
