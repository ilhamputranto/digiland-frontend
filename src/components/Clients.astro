---
// Catatan: file logo klien perlu ditaruh di src/images/ (lihat DAFTAR-GAMBAR.md).
//
// Marquee infinite: list logo di-duplikasi 2x berurutan, lalu track-nya
// digeser terus via CSS animation dari 0 sampai -50% (yaitu persis
// selebar 1 set logo asli). Begitu sampai -50%, isinya identik dengan
// posisi awal, jadi loop-nya terlihat mulus tanpa "patah".
import { Image } from 'astro:assets';
import terraLogo from '../images/client-terra-indonesia.png';
import henwaLogo from '../images/client-henwa.png';
import westVistaLogo from '../images/client-west-vista.png';
import kalaniasiaLogo from '../images/client-kalaniasia.png';
import witekLogo from '../images/client-Witek-Logistics.webp';
import dianristyLogo from '../images/client-DianRisty.webp';
import sinarSaktiLogo from '../images/client-sinarsaktiunion.webp';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const clients = [
  { name: 'Terra Indonesia', logo: terraLogo },
  { name: 'Henwa Logistics', logo: henwaLogo },
  { name: 'West Vista', logo: westVistaLogo },
  { name: 'Kalani Astha Asia', logo: kalaniasiaLogo },
  { name: 'Witek Logistics', logo: witekLogo },
  { name: 'Dianristy', logo: dianristyLogo },
  { name: 'Sinar Sakti Union', logo: sinarSaktiLogo },
];

// Set kedua ditandai aria-hidden supaya screen reader tidak baca logo yang
// sama 2x - secara visual tetap dobel untuk keperluan loop.
const loopedClients = [
  ...clients.map((c) => ({ ...c, hidden: false })),
  ...clients.map((c) => ({ ...c, hidden: true })),
];
---
<section id="clients" class="clients reveal">
  <div class="wrap">
    <p class="eyebrow center">{t('clients.eyebrow')}</p>
    <div class="marquee">
      <div class="track">
        {loopedClients.map((c) => (
          <Image
            src={c.logo}
            alt={c.hidden ? '' : c.name}
            aria-hidden={c.hidden ? 'true' : 'false'}
            width={150}
            class="client-logo"
          />
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .clients {
    padding: 2rem 0 5.5rem;
  }
  .eyebrow.center {
    display: block;
    text-align: center;
    width: fit-content;
    margin: 0 auto 2rem;
  }

  .marquee {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .track {
    display: flex;
    align-items: center;
    gap: 3rem;
    width: max-content;
    animation: marquee-scroll 32s linear infinite;
  }
  .marquee:hover .track {
    animation-play-state: paused;
  }
  @keyframes marquee-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  .track :global(.client-logo) {
    height: 200px;
    width: auto;
    flex-shrink: 0;
    filter: grayscale(1);
    opacity: 0.6;
    transition: filter 0.25s ease, opacity 0.25s ease;
  }
  .track :global(.client-logo:hover) {
    filter: grayscale(0);
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
    }
  }
  /* tambahkan di dalam <style> Clients.astro */
  @media (max-width: 900px) {
    .track :global(.client-logo) { height: 110px; }
    .track { gap: 2rem; }
    }
  @media (max-width: 560px) {
    .track :global(.client-logo) { height: 70px; }
    .track { gap: 1.5rem; }
    }
</style>
