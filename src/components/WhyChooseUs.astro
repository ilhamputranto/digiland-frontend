---
// Icon diganti pakai path yang lebih baku/jelas bentuknya (target, shield-check,
// users, rocket) - sebelumnya path custom saya terlalu abstrak dan susah dikenali.
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const points = [
  {
    color: '#7f3f99',
    title: t('why.data.title'),
    desc: t('why.data.desc'),
    icon: [
      'M12 21a9 9 0 100-18 9 9 0 000 18z',
      'M12 16a4 4 0 100-8 4 4 0 000 8z',
      'M12 12.5a.5.5 0 100-1 .5.5 0 000 1z',
    ],
    fillCenter: true,
  },
  {
    color: '#fcb040',
    title: t('why.transparent.title'),
    desc: t('why.transparent.desc'),
    icon: [
      'M12 2.5l7.5 3.4v5.4c0 4.9-3.2 8.9-7.5 10.2-4.3-1.3-7.5-5.3-7.5-10.2V5.9L12 2.5z',
      'M9 12.2l2 2 4-4.4',
    ],
  },
  {
    color: '#ed227d',
    title: t('why.client.title'),
    desc: t('why.client.desc'),
    icon: [
      'M16 21v-1.5a4 4 0 00-4-4H7a4 4 0 00-4 4V21',
      'M9.5 11.5a3.5 3.5 0 100-7 3.5 3.5 0 000 7z',
      'M21 21v-1.5a4 4 0 00-3-3.87',
      'M15.5 4.13a4 4 0 010 7.75',
    ],
  },
  {
    color: '#7f3f99',
    title: t('why.results.title'),
    desc: t('why.results.desc'),
    icon: [
      'M4.5 16.5c-1.4 1.2-1.9 4.6-1.9 4.6s3.4-.5 4.6-1.9c.7-.8.7-2-.1-2.7a1.9 1.9 0 00-2.6.1z',
      'M11.5 14.5l-2.8-2.8a20 20 0 011.9-3.6C12.7 5 16.3 2.5 20.5 2c0 4.2-2.3 7.8-5.5 9.9a20 20 0 01-3.5 2.1z',
      'M8.5 11.5H4.2s.5-2.7 1.8-3.6c1.5-1 4.5 0 4.5 0',
      'M11.5 14.5v4.3s2.7-.5 3.6-1.8c1-1.5 0-4.5 0-4.5',
    ],
  },
];
---
<section id="why-us" class="why-us">
  <div class="wrap">
    <div class="section-head center reveal">
      <p class="eyebrow">{t('why.eyebrow')}</p>
      <h2>{t('why.title')}</h2>
    </div>

    <div class="points-row">
      {points.map((p, i) => (
        <div class={`point reveal reveal-${i}`}>
          <div class="icon-wrap" style={`background:${p.color}1a; color:${p.color};`}>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              {p.icon.map((d, idx) => (
                <path d={d} fill={p.fillCenter && idx === 2 ? 'currentColor' : 'none'} />
              ))}
            </svg>
          </div>
          <div class="point-text">
            <h3>{p.title}</h3>
            <p>{p.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .why-us {
    padding: 5rem 0 6rem;
  }
  .points-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  .point {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 0 1.75rem;
    border-left: 1px solid var(--line);
  }
  .point:first-child {
    border-left: none;
    padding-left: 0;
  }
  .icon-wrap {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }
  .point-text h3 {
    font-size: 0.96rem;
    font-weight: 700;
    font-family: var(--font-body);
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }
  .point-text p {
    color: var(--slate);
    font-size: 0.86rem;
    line-height: 1.55;
    margin: 0;
  }

  .reveal-1 { transition-delay: 0.08s; }
  .reveal-2 { transition-delay: 0.16s; }
  .reveal-3 { transition-delay: 0.24s; }

  @media (max-width: 900px) {
    .points-row {
      grid-template-columns: 1fr 1fr;
      gap: 2rem 0;
    }
    .point:nth-child(2n+1) { border-left: none; padding-left: 0; }
  }
  @media (max-width: 560px) {
    .points-row { grid-template-columns: 1fr; }
    .point { border-left: none !important; padding-left: 0 !important; }
  }
</style>
