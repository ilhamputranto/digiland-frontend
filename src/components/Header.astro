---
// Header - menu disesuaikan dengan mockup baru (Home, About, Services,
// Portfolio, Blog, Contact) + tombol "Contact Us" gradient di kanan.
// Active-state nav dideteksi dari URL saat ini (Astro.url.pathname).
//
// Mobile (<900px): nav horizontal disembunyikan, diganti tombol hamburger
// yang membuka panel menu slide-in dari kanan (lihat <script> di bawah).
//
// i18n: terima prop `lang`, translate label nav lewat dictionary, dan
// tampilkan language switcher (icon bendera) untuk pindah EN <-> ID.
import { Image } from 'astro:assets';
import logo from '../images/logo-digiland.id-black.webp';
import { useTranslations, getLocalizedPath, languages, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const navItems = [
  { label: t('nav.home'), href: '/' },
  { label: t('nav.about'), href: '/#about' },
  { label: t('nav.services'), href: '/#services' },
  { label: t('nav.portfolio'), href: '/#clients' },
  { label: t('nav.blog'), href: '/blog' },
  { label: t('nav.contact'), href: '/#contact' },
];

const path = Astro.url.pathname;
function isActive(href: string) {
  const cleanPath = path.replace(/^\/id(\/|$)/, '/');
  if (href === '/') return cleanPath === '/';
  if (href.startsWith('/#')) return cleanPath === '/';
  return cleanPath.startsWith(href);
}
---
<header class="site-header">
  <div class="wrap bar">
    <a href={lang === 'en' ? '/' : '/id'} class="logo">
      <Image src={logo} alt="Digiland.id" width={150} height={38} />
    </a>

    <nav class="nav-desktop">
      {navItems.map((item) => (
        <a href={item.href} class={isActive(item.href) ? 'active' : ''}>
          {item.label}
          {isActive(item.href) && <span class="dot" aria-hidden="true"></span>}
        </a>
      ))}
    </nav>

    <div class="right-cluster">
      <div class="lang-switch" role="group" aria-label="Language">
        <a
          href={getLocalizedPath(path, 'en')}
          class={lang === 'en' ? 'lang-option active' : 'lang-option'}
          aria-current={lang === 'en' ? 'true' : 'false'}
        >
          <span class="flag">{languages.en.flag}</span> EN
        </a>
        <span class="lang-sep">|</span>
        <a
          href={getLocalizedPath(path, 'id')}
          class={lang === 'id' ? 'lang-option active' : 'lang-option'}
          aria-current={lang === 'id' ? 'true' : 'false'}
        >
          <span class="flag">{languages.id.flag}</span> ID
        </a>
      </div>

      <a href="/#contact" class="btn btn-gradient contact-btn">
        {t('nav.contactBtn')}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>

      <button type="button" class="hamburger" id="menu-open-btn" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<!-- Overlay gelap di belakang panel, klik ini juga menutup menu -->
<div class="menu-overlay" id="menu-overlay" hidden></div>

<!-- Panel menu mobile, slide dari kanan -->
<nav class="mobile-menu" id="mobile-menu" aria-label="Mobile menu" aria-hidden="true">
  <div class="mobile-menu-head">
    <Image src={logo} alt="Digiland.id" width={120} height={30} />
    <button type="button" class="menu-close-btn" id="menu-close-btn" aria-label="Close menu">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
  </div>
  <ul>
    {navItems.map((item) => (
      <li>
        <a href={item.href} class={isActive(item.href) ? 'active' : ''}>{item.label}</a>
      </li>
    ))}
  </ul>
  <div class="mobile-lang-switch">
    <a
      href={getLocalizedPath(path, 'en')}
      class={lang === 'en' ? 'mobile-lang-option active' : 'mobile-lang-option'}
    >
      <span class="flag">{languages.en.flag}</span> English
    </a>
    <a
      href={getLocalizedPath(path, 'id')}
      class={lang === 'id' ? 'mobile-lang-option active' : 'mobile-lang-option'}
    >
      <span class="flag">{languages.id.flag}</span> Indonesia
    </a>
  </div>
  <a href="/#contact" class="btn btn-gradient mobile-contact-btn">
    {t('nav.contactBtn')}
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
  </a>
</nav>

<style>
  .site-header {
    background: var(--paper);
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    z-index: 40;
    backdrop-filter: blur(8px);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 0.9rem;
    gap: 1.5rem;
  }
  .logo img { display: block; }

  .nav-desktop {
    display: flex;
    gap: 1.9rem;
    flex: 1;
    justify-content: center;
  }
  .nav-desktop a {
    position: relative;
    text-decoration: none;
    color: var(--slate);
    font-weight: 500;
    font-size: 0.92rem;
    padding-bottom: 4px;
  }
  .nav-desktop a.active {
    color: var(--ink);
    font-weight: 600;
  }
  .nav-desktop a .dot {
    position: absolute;
    left: 50%;
    bottom: -3px;
    transform: translateX(-50%);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--logo-purple);
  }

  .right-cluster {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-shrink: 0;
  }

  /* ---- language switcher: 2 bendera sekaligus, yang aktif ditandai jelas ---- */
  .lang-switch {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.35rem 0.7rem;
  }
  .lang-option {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    text-decoration: none;
    color: var(--slate);
    font-size: 0.82rem;
    font-weight: 600;
    opacity: 0.55;
    transition: opacity 0.2s ease, color 0.2s ease;
  }
  .lang-option:hover {
    opacity: 0.85;
  }
  .lang-option.active {
    color: var(--ink);
    opacity: 1;
  }
  .lang-option .flag {
    font-size: 1rem;
    line-height: 1;
  }
  .lang-sep {
    color: var(--line);
    font-size: 0.75rem;
  }

  .contact-btn { padding: 0.65rem 1.4rem; }

  /* ---- hamburger button (disembunyikan di desktop) ---- */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #fff;
    cursor: pointer;
    flex-shrink: 0;
    padding: 0;
  }
  .hamburger span {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--ink);
    margin: 0 auto;
    border-radius: 2px;
  }

  /* ---- overlay + panel mobile (disembunyikan di desktop) ---- */
  .menu-overlay {
    position: fixed;
    inset: 0;
    background: rgba(20, 20, 20, 0.45);
    z-index: 49;
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .menu-overlay.is-open {
    opacity: 1;
  }

  .mobile-menu {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(78vw, 320px);
    background: #fff;
    z-index: 50;
    display: flex;
    flex-direction: column;
    padding: 1.25rem 1.5rem 2rem;
    transform: translateX(100%);
    transition: transform 0.3s ease;
    box-shadow: -12px 0 32px rgba(0, 0, 0, 0.12);
  }
  .mobile-menu.is-open {
    transform: translateX(0);
  }
  .mobile-menu-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 1.25rem;
  }
  .menu-close-btn {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: #fff;
    display: grid;
    place-items: center;
    color: var(--ink);
    cursor: pointer;
  }
  .mobile-menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .mobile-menu ul a {
    display: block;
    padding: 0.85rem 0.25rem;
    text-decoration: none;
    color: var(--ink);
    font-weight: 500;
    font-size: 1.02rem;
    border-bottom: 1px solid var(--line);
  }
  .mobile-menu ul a.active {
    color: var(--logo-purple);
    font-weight: 700;
  }
  .mobile-lang-switch {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 0.85rem 0.25rem;
    border-bottom: 1px solid var(--line);
  }
  .mobile-lang-option {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    color: var(--slate);
    font-weight: 600;
    font-size: 0.92rem;
    opacity: 0.55;
  }
  .mobile-lang-option.active {
    color: var(--logo-purple);
    opacity: 1;
  }
  .mobile-lang-option .flag { font-size: 1.15rem; }
  .mobile-contact-btn {
    justify-content: center;
    margin-top: 1.25rem;
  }

  @media (max-width: 900px) {
    .nav-desktop,
    .contact-btn {
      display: none;
    }
    .hamburger {
      display: flex;
    }
  }
</style>

<script>
  const openBtn = document.getElementById('menu-open-btn');
  const closeBtn = document.getElementById('menu-close-btn');
  const overlay = document.getElementById('menu-overlay');
  const panel = document.getElementById('mobile-menu');

  function openMenu() {
    panel?.classList.add('is-open');
    overlay?.removeAttribute('hidden');
    requestAnimationFrame(() => overlay?.classList.add('is-open'));
    panel?.setAttribute('aria-hidden', 'false');
    openBtn?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    panel?.classList.remove('is-open');
    overlay?.classList.remove('is-open');
    panel?.setAttribute('aria-hidden', 'true');
    openBtn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    setTimeout(() => overlay?.setAttribute('hidden', ''), 250);
  }

  openBtn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  overlay?.addEventListener('click', closeMenu);
  panel?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });
</script>