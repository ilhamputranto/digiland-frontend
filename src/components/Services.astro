---
// 4 layanan dipetakan ke 4 warna logo secara berurutan (biru, pink, oranye,
// ungu) - jumlahnya kebetulan sama-sama 4, jadi warnanya benar-benar
// merepresentasikan identitas brand, bukan pilihan acak.
const services = [
  {
    color: '#24aae1',
    title: 'Search Engine Optimization (SEO)',
    desc: 'Tingkatkan peringkat website Anda di Google dan dapatkan traffic organik berkualitas.',
    icon: 'M11 4a7 7 0 104.9 12.02l4.55 4.55 1.41-1.41-4.55-4.55A7 7 0 0011 4zm0 2a5 5 0 110 10 5 5 0 010-10z',
  },
  {
    color: '#ed227d',
    title: 'Pay-Per-Click (PPC Advertising)',
    desc: 'Iklan yang tepat sasaran untuk mendatangkan traffic dan leads berkualitas dengan cepat.',
    icon: 'M4 3l16 7-6.5 2.5L11 19z',
  },
  {
    color: '#fcb040',
    title: 'Social Media Marketing',
    desc: 'Bangun brand awareness dan engagement di media sosial yang relevan dengan audiens Anda.',
    icon: 'M4 4h16v12H8l-4 4V4z',
  },
  {
    color: '#7f3f99',
    title: 'Website Development',
    desc: 'Website profesional, cepat, dan mobile-friendly yang dirancang untuk konversi maksimal.',
    icon: 'M8 6L2 12l6 6M16 6l6 6-6 6M14 4l-4 16',
  },
];
---
<section id="services" class="services">
  <div class="wrap">
    <div class="section-head center reveal">
      <p class="eyebrow">What We Do</p>
      <h2>Our Services</h2>
      <p>Layanan digital marketing terlengkap untuk mengakselerasi pertumbuhan bisnis Anda.</p>
    </div>

    <div class="service-grid">
      {services.map((s, i) => (
        <div class={`service-card reveal reveal-${i}`}>
          <div class="icon-wrap" style={`background:${s.color}1a; color:${s.color};`}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d={s.icon} />
            </svg>
          </div>
          <h3>{s.title}</h3>
          <p>{s.desc}</p>
          <a href="#contact" class="learn-more" style={`color:${s.color}`}>
            Learn more <span aria-hidden="true">→</span>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .services {
    padding: 10rem 0;
    background: var(--paper-2);
  }
  .service-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1.25rem;
  }
  .service-card {
    background: var(--paper);
    padding: 2rem 1.75rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card);
  }
  .icon-wrap {
    width: 46px;
    height: 46px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    margin-bottom: 1.25rem;
  }
  .service-card h3 {
    font-size: 1.02rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    font-family: var(--font-body);
  }
  .service-card p {
    color: var(--slate);
    font-size: 0.9rem;
    line-height: 1.55;
    margin: 0 0 1rem;
  }
  .learn-more {
    font-size: 0.86rem;
    font-weight: 600;
    text-decoration: none;
  }
  .learn-more span { display: inline-block; transition: transform 0.2s ease; }
  .learn-more:hover span { transform: translateX(3px); }

  .reveal-1 { transition-delay: 0.08s; }
  .reveal-2 { transition-delay: 0.16s; }
  .reveal-3 { transition-delay: 0.24s; }
</style>
