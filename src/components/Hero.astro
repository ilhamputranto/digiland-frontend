---
// Hero - redesign kedua, mengikuti mockup: kiri teks+CTA+avatar trust row,
// kanan "dashboard" mengambang (traffic chart, keyword ranking, leads,
// conversion rate) mengelilingi lambang logo di tengah.
import { Image } from 'astro:assets';
import rina from '../images/rina.webp';
import andi from '../images/andi.webp';
import daniel from '../images/daniel.webp';
import maya from '../images/maya.webp';
import kevin from '../images/Kevin.webp';
import favicon from '../images/favicon-digiland.png';
import testiHendra from '../images/testimonial-hendra-widjaya.webp';
import testiYasni from '../images/testimonial-yasni-lavinia.webp';
import testiFitri from '../images/testimonial-fitri.webp';

const trustAvatars = [
  { src: rina, alt: 'Rina' },
  { src: andi, alt: 'Andi' },
  { src: daniel, alt: 'Daniel' },
  { src: maya, alt: 'Maya' },
  { src: kevin, alt: 'Kevin' },
];

// Kartu "Leads Generated" - 3 foto diambil acak dari gabungan foto trust-row
// + foto testimonial, supaya tidak selalu sama tiap kali dilihat.
const avatarPool = [
  ...trustAvatars,
  { src: testiHendra, alt: 'Client' },
  { src: testiYasni, alt: 'Client' },
  { src: testiFitri, alt: 'Client' },
];
const leadsAvatars = [...avatarPool].sort(() => Math.random() - 0.5).slice(0, 3);
---
<section class="hero">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="dot-grid" aria-hidden="true"></div>

  <div class="wrap hero-inner">
    <div class="hero-copy">
      <p class="eyebrow">Digital Marketing Agency</p>
      <h1>
        Grow your business<br />
        through <span class="accent">SEO &amp;<br />Digital Marketing</span>
      </h1>
      <p class="subhead">
        Strategi data-driven untuk meningkatkan visibilitas, trafik, dan
        konversi bisnis Anda secara signifikan.
      </p>

      <div class="hero-actions">
        <a href="#contact" class="btn btn-gradient">Free SEO Audit
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a href="#services" class="btn btn-outline">Our Services
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>

      <div class="trust-row">
        <div class="avatar-stack" aria-hidden="true">
          {trustAvatars.map((a) => (
            <Image src={a.src} alt={a.alt} width={64} height={64} class="avatar-photo" />
          ))}
        </div>
        <p><strong>50+</strong> Klien percaya pada kami</p>
      </div>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="mark" aria-hidden="true">
        <Image src={favicon} alt="" width={40} height={40} class="mark-icon" />
      </div>

      <div class="float-card card-traffic">
        <p class="label">Organic Traffic</p>
        <p class="value">25.6K <span class="up">+23.5%</span></p>
        <svg class="mini-chart" viewBox="0 0 100 30" preserveAspectRatio="none">
          <polyline points="0,25 15,20 30,22 45,12 60,15 75,6 100,2" fill="none" stroke="#7f3f99" stroke-width="2.5"/>
        </svg>
      </div>

      <div class="float-card card-keyword">
        <p class="label">Keyword Ranking</p>
        <p class="value big">Top 3 <span class="up">+15 Keywords</span></p>
        <div class="bars" aria-hidden="true">
          <span style="height:30%;background:#f6c9de"></span>
          <span style="height:45%;background:#f6c9de"></span>
          <span style="height:60%;background:#ed227d"></span>
          <span style="height:80%;background:#ed227d"></span>
          <span style="height:100%;background:#7f3f99"></span>
        </div>
      </div>

      <div class="float-card card-leads">
        <p class="label">Leads Generated</p>
        <p class="value">1,248 <span class="up">+32.1%</span></p>
        <div class="avatar-stack small" aria-hidden="true">
          {leadsAvatars.map((a) => (
            <Image src={a.src} alt={a.alt} width={44} height={44} class="avatar-photo" />
          ))}
        </div>
      </div>

      <div class="float-card card-conversion">
        <p class="label">Conversion Rate</p>
        <div class="donut" style="--val:18.7"></div>
        <p class="value small centered"><span class="up">+18.7%</span></p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: linear-gradient(180deg, #faf6ff 0%, #fff 60%);
    overflow: hidden;
    padding: 4rem 0 5rem;
  }
  .hero-glow {
    position: absolute;
    inset: -10% -5% auto -5%;
    height: 55%;
    background: var(--spectrum);
    filter: blur(140px);
    opacity: 0.16;
    pointer-events: none;
  }
  .dot-grid {
    position: absolute;
    top: 6%;
    right: 4%;
    width: 120px;
    height: 90px;
    background-image: radial-gradient(var(--logo-purple) 1.4px, transparent 1.4px);
    background-size: 14px 14px;
    opacity: 0.25;
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  .eyebrow { background: rgba(127,63,153,0.1); }

  h1 {
    font-size: clamp(2rem, 3.4vw, 2.9rem);
    line-height: 1.18;
    color: var(--ink);
  }
  .accent {
    background: var(--spectrum-btn);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .subhead {
    margin: 1.25rem 0 0;
    max-width: 30rem;
    color: var(--slate);
    line-height: 1.7;
  }
  .hero-actions {
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin-top: 1.75rem;
  }

  .trust-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2.25rem;
    font-size: 0.88rem;
    color: var(--slate);
  }
  .trust-row strong { color: var(--ink); }
  .avatar-stack {
    display: flex;
  }
  .avatar-stack :global(img.avatar-photo) {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 2px solid #fff;
    margin-left: -10px;
    object-fit: cover;
    display: block;
  }
  .avatar-stack :global(img.avatar-photo:first-child) { margin-left: 0; }
  .avatar-stack.small :global(img.avatar-photo) {
    width: 20px;
    height: 20px;
    margin-left: -7px;
  }
  .avatar-stack.small :global(img.avatar-photo:first-child) { margin-left: 0; }

  /* ---- visual dashboard ---- */
  .hero-visual {
    position: relative;
    height: 440px;
  }
  .mark {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 92px;
    height: 92px;
    border-radius: 50%;
    background: #fff;
    display: grid;
    place-items: center;
    box-shadow: 0 0 0 14px rgba(255,255,255,0.6), var(--shadow-float);
  }
  .mark :global(.mark-icon) {
    width: 40px;
    height: 40px;
    object-fit: contain;
    display: block;
  }

  .float-card {
    position: absolute;
    background: #fff;
    border-radius: 14px;
    padding: 0.9rem 1.1rem;
    box-shadow: var(--shadow-card);
    width: 160px;
    opacity: 0;
    animation: cardIn 0.6s ease both, floatY 4.5s ease-in-out infinite;
  }
  .float-card .label {
    font-size: 0.72rem;
    color: var(--slate);
    margin: 0 0 0.3rem;
  }
  .float-card .value {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }
  .float-card .value.big { font-size: 1.05rem; }
  .float-card .value.small { font-size: 0.95rem; }
  .float-card .value.centered { justify-content: center; margin-top: 0.4rem; }
  .up {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 600;
    color: #16a34a;
  }
  .mini-chart { width: 100%; height: 26px; margin-top: 0.5rem; }
  .bars {
    display: flex;
    align-items: flex-end;
    gap: 4px;
    height: 34px;
    margin-top: 0.6rem;
  }
  .bars span {
    flex: 1;
    border-radius: 3px 3px 0 0;
  }
  .donut {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    margin: 0.4rem auto 0;
    /* Sebelumnya --val dikonversi ke persen lalu dikali deg (tipe tidak
       valid di CSS, jadi browser diam-diam abaikan -> lingkaran kosong).
       Sekarang dihitung langsung: val(0-100) * 3.6deg = sudut lingkaran. */
    background: conic-gradient(
      var(--logo-purple) 0deg,
      var(--logo-pink) calc(var(--val) * 1.8deg),
      var(--logo-orange) calc(var(--val) * 3.6deg),
      #f1e6f5 calc(var(--val) * 3.6deg) 360deg
    );
    display: grid;
    place-items: center;
  }
  .donut::after {
    content: '';
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #fff;
  }

  .card-traffic { top: 4%; left: 2%; animation-delay: 0.1s, 0.1s; }
  .card-keyword { top: 2%; right: 0; animation-delay: 0.25s, 0.6s; }
  .card-leads { bottom: 18%; left: 0; animation-delay: 0.4s, 1.1s; }
  .card-conversion { bottom: 14%; right: 4%; text-align: center; animation-delay: 0.55s, 1.6s; }

  @keyframes cardIn {
    from { opacity: 0; transform: translateY(14px) scale(0.96); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }
  @keyframes floatY {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  @media (max-width: 900px) {
    .hero-inner { grid-template-columns: 1fr; }
    .hero-copy { text-align: center; }
    .hero-copy .subhead { margin-inline: auto; }
    .hero-actions, .trust-row { justify-content: center; }
    .hero-visual { height: 320px; margin-top: 1rem; }
    .float-card { width: 130px; padding: 0.7rem 0.85rem; }
    .mark { width: 70px; height: 70px; }
    .mark :global(.mark-icon) { width: 32px; height: 32px; }
  }
</style>