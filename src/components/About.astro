---
import { Image } from 'astro:assets';
import officePhoto from '../images/coworking-office.jpg';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const checklist = [t('about.check1'), t('about.check2'), t('about.check3')];
---
<section id="about" class="about">
  <div class="wrap about-inner">
    <div class="about-text reveal">
      <p class="eyebrow">{t('about.eyebrow')}</p>
      <h2>{t('about.title')}</h2>
      <p class="body-text">
        {t('about.body')}
      </p>
      <ul class="checklist">
        {checklist.map((item) => (
          <li>
            <span class="check" aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            {item}
          </li>
        ))}
      </ul>
      <a href="#services" class="btn btn-outline-pink">{t('about.cta')}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>

    <div class="about-visual reveal">
      <div class="dot-grid" aria-hidden="true"></div>
      <Image src={officePhoto} alt="Digiland.id team at work" width={640} height={520} class="office-photo" />
      <div class="float-card card-years">
        <p class="value">7+</p>
        <p class="label">{t('about.card.years')}</p>
      </div>
      <div class="float-card card-projects">
        <p class="value orange">100+</p>
        <p class="label">{t('about.card.projects')}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    padding: 6rem 0;
  }
  .about-inner {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 3rem;
    align-items: center;
  }
  .about-text h2 {
    font-size: clamp(1.7rem, 2.8vw, 2.3rem);
    margin-top: 0.4rem;
  }
  .body-text {
    margin: 1.1rem 0 1.4rem;
    color: var(--slate);
    line-height: 1.7;
  }
  .checklist {
    list-style: none;
    padding: 0;
    margin: 0 0 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .checklist li {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.94rem;
  }
  .check {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--logo-purple);
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .about-visual {
    position: relative;
  }
  .dot-grid {
    position: absolute;
    top: -14%;
    left: -8%;
    width: 100px;
    height: 80px;
    background-image: radial-gradient(var(--logo-purple) 1.4px, transparent 1.4px);
    background-size: 13px 13px;
    opacity: 0.3;
    z-index: -1;
  }
  .about-visual :global(.office-photo) {
    width: 100%;
    height: auto;
    border-radius: 18px;
    display: block;
  }
  .float-card {
    position: absolute;
    background: #fff;
    border-radius: 12px;
    padding: 0.85rem 1.1rem;
    box-shadow: var(--shadow-card);
  }
  .float-card .value {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--logo-purple);
    margin: 0;
  }
  .float-card .value.orange { color: var(--logo-orange); }
  .float-card .label {
    font-size: 0.75rem;
    color: var(--slate);
    margin: 0.1rem 0 0;
  }
  .card-years { top: 12%; left: -6%; }
  .card-projects { bottom: 8%; left: -6%; }

  @media (max-width: 900px) {
    .about-inner { grid-template-columns: 1fr; }
    .about-visual { margin-top: 1.5rem; }
    .float-card { position: static; display: inline-block; margin: 0.5rem 0.5rem 0 0; }
  }
</style>
