---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const stats = [
  {
    color: '#24aae1',
    icon: 'M4 14l6-6 4 4 6-8M20 4v6h-6',
    value: '184%',
    label: t('stats.traffic'),
  },
  {
    color: '#fcb040',
    icon: 'M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87M15 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a4 4 0 00-4 4M17 7a4 4 0 010 6',
    value: '50+',
    label: t('stats.clients'),
  },
  {
    color: '#ed227d',
    icon: 'M12 3l2.6 5.6L21 9.3l-4.6 4.3L17.6 20 12 16.9 6.4 20l1.2-6.4L3 9.3l6.4-.7L12 3z',
    value: '5.0',
    label: t('stats.rating'),
  },
  {
    color: '#7f3f99',
    icon: 'M8 21h8M12 17v4M7 4h10v4a5 5 0 01-10 0V4zM7 6H4a3 3 0 003 3M17 6h3a3 3 0 01-3 3',
    value: '7+',
    label: t('stats.experience'),
  },
];
---
<section class="stats-bar reveal">
  <div class="wrap stats-grid">
    {stats.map((s) => (
      <div class="stat-card">
        <div class="icon-wrap" style={`background:${s.color}1a; color:${s.color};`}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d={s.icon} />
          </svg>
        </div>
        <div>
          <p class="value">{s.value}</p>
          <p class="label">{s.label}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .stats-bar {
    margin-top: -3.5rem;
    position: relative;
    z-index: 5;
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  .stat-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    box-shadow: var(--shadow-card);
  }
  .icon-wrap {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }
  .value {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    margin: 0;
  }
  .label {
    font-size: 0.78rem;
    color: var(--slate);
    margin: 0.15rem 0 0;
    line-height: 1.35;
  }

  @media (max-width: 900px) {
    .stats-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .stats-grid { grid-template-columns: 1fr; }
    .stats-bar { margin-top: -2rem; }
  }
</style>
