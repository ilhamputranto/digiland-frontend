---
interface Props {
  code: 'gb' | 'id';
  size?: number;
}
const { code, size = 16 } = Astro.props;
---
<span class="flag-icon" style={`width:${size}px;height:${size}px`}>
  {code === 'gb' && (
    <svg viewBox="0 0 24 24" width="100%" height="100%" aria-hidden="true">
      <rect width="24" height="24" fill="#00247d" />
      <path d="M0 0L24 24M24 0L0 24" stroke="#fff" stroke-width="4" />
      <path d="M0 0L24 24M24 0L0 24" stroke="#cf142b" stroke-width="2" />
      <path d="M12 0V24M0 12H24" stroke="#fff" stroke-width="6" />
      <path d="M12 0V24M0 12H24" stroke="#cf142b" stroke-width="3.5" />
    </svg>
  )}
  {code === 'id' && (
    <svg viewBox="0 0 24 24" width="100%" height="100%" aria-hidden="true">
      <rect width="24" height="12" fill="#ce1126" />
      <rect y="12" width="24" height="12" fill="#fff" />
    </svg>
  )}
</span>

<style>
  .flag-icon {
    display: inline-flex;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    line-height: 0;
  }
  .flag-icon svg {
    display: block;
  }
</style>